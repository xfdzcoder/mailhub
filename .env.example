DATABASE_URL=
REDIS_URL=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
JWT_SECRET=
ENCRYPTION_KEY=

# Worker and database sync limits (per Node.js process)
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
SYNC_WORKER_CONCURRENCY=1
EMAIL_PERSIST_CONCURRENCY=3
IMAP_STARTUP_CONCURRENCY=10
GMAIL_POLL_INTERVAL_MS=60000
GMAIL_REQUEST_INTERVAL_MS=1000
IMAP_REQUEST_INTERVAL_MS=250
IMAP_RECONCILE_INTERVAL_MS=300000

# Optional: allow IMAP/SMTP connections to explicitly allowlisted hosts that
# resolve into reserved/non-public ranges (LAN mail servers or transparent-proxy
# fake-IP DNS). Format: host=cidr[,host=cidr]. Exact hostname match; IP literals
# are not allowed.
OUTBOUND_HOST_ALLOWLIST=

# BullMQ Dashboard
BULLMQ_DASHBOARD_USERNAME=
BULLMQ_DASHBOARD_PASSWORD=

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email OAuth (Microsoft)
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# AI & Meilisearch Vector Embedding Settings
AI_API_URL="your-ai-api-url"
AI_MODEL="your-ai-model"
MEILISEARCH_EMBED_URL="your-meilisearch-embed-url"
MEILISEARCH_EMBED_API_KEY="your-meilisearch-embed-api-key"
MEILISEARCH_EMBED_MODEL="your-meilisearch-embed-model"

# App Settings
NEXT_PUBLIC_APP_URL=

# Self-registration is closed by default. Use exactly open to enable it.
# Existing login and operator-run create-admin are unaffected.
REGISTRATION_MODE=closed

# Instance settings access: comma-separated exact User.id values. Empty denies all.
# Each user must also currently be an admin in their active organization.
INSTANCE_ADMIN_USER_IDS=

# Model-only outbound approval. Unset permits public OpenAI/Anthropic origins.
# JSON replaces defaults. Each origin is exact (scheme, host, port); addresses
# optionally pins ALL DNS answers to explicit IPs/CIDRs, including local services.
# MODEL_ORIGIN_POLICY='[{"origin":"https://api.openai.com"},{"origin":"http://localhost:11434","addresses":["127.0.0.1/32","::1/128"]}]'
MODEL_ORIGIN_POLICY=
# Model-client deployment defaults (tenant endpoint settings do not approve origins).
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
# Shared keys are sent only to this origin (default: provider's OpenAI/Anthropic origin).
AI_SHARED_CREDENTIAL_ORIGIN=
